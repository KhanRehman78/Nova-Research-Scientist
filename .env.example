# These values are publishable and may be configured in Vercel.
# Never place a database password, service-role key, Supabase access token,
# OpenAI key, or OpenAlex key in a VITE_* variable.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional paid PlagAware UI. Keep false unless the provider account has credits.
VITE_ENABLE_EXTERNAL_SIMILARITY=false
