# These values are publishable and may be configured in Vercel.
# Never place a database password, service-role key, Supabase access token,
# OpenAI key, or OpenAlex key in a VITE_* variable.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional Copyleaks similarity UI. The API credentials stay in Supabase Edge
# secrets; never expose them through a VITE_* variable.
VITE_ENABLE_EXTERNAL_SIMILARITY=false
# Separate owner deployment only: set VITE_APP_SURFACE=owner.
# VITE_MAIN_APP_URL=https://nova-research-scientist.vercel.app
